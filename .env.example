# Gemini API credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Notion API credentials & targets
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DSA_PARENT_PAGE_ID=your_dsa_parent_page_id_here
NOTION_SQL_DB_ID=your_sql_database_id_here

# Google Drive credentials (OAuth 2.0)
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token_here
